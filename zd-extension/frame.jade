//- output: frame.html, pretty: true

doctype html
html
  head
    meta(http-equiv='content-type', content='text/html;charset=UTF-8')
    meta(charset='utf-8')
    link(rel='stylesheet', type='text/css', href='css/fonts/fonts.css')
    link(rel='stylesheet', type='text/css', href='css/zoopdog.css')
    link(rel='stylesheet', type='text/css', href='css/zoopdog-frame.css')
    link(rel='stylesheet', type='text/css', href='css/zd-pron.css')

  body
    #zoopdog-popup-lock-icon 📌
    #zoopdog-popup-body
    script(src="js/lib/handlebars.min.js")
    script(id="zoopdog-popup-template" type="text/x-handlebars-template").
      {{#each results}}
        <div class="zd-definition">
          <h1>{{#each headwords}}{{this}}{{#unless @last}} / {{/unless}}{{/each}}</h1>
          <div class="zd-pronunciation">{{headwords.[0]}}</div>
          <ul>
            {{#each en}}
              <li>
                {{#if headword}}<span class="zoopdog-headword">{{headword}}</span>{{/if}}
                {{#if pos}}<span class="zoopdog-pos">{{pos}}</span>{{/if}}
                {{def}}
              </li>
            {{/each}}
          </ul>
        </div>
      {{/each}}
    script(src="js/lib/chroma.min.js")
    script(src="js/zd-pron-data.js")
    script(src="js/zd-pron-core.js")
    script(src="js/zd-pron-drawtones.js")
    script(src="js/zd-pron-functions.js")
    script(src="js/zd-popup-protocol.js")
    script(src="js/frame.js")
